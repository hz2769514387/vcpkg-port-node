{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "What every cell shares. VCPKG_ROOT has to point at a bootstrapped vcpkg checkout.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "NODE_TEST_JOBS": "$env{VCPKG_MAX_CONCURRENCY}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "inherits": "base",
      "description": "Single-configuration generators only; on Windows the configuration is chosen at build time.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "inherits": "base",
      "description": "Single-configuration generators only. Needs a triplet that installs Debug - a dual one does.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-clang",
      "hidden": true,
      "inherits": "release",
      "description": "The compiler Node.js itself requires on Windows, and the one this port builds with. host=x64 is explicit: the ClangCL toolset links with lld-link from VC\\Tools\\Llvm\bin for an x86 host (PE32, 2 GB address space) and from VC\\Tools\\Llvmd\bin for an x64 host (PE32+). The static v8 archive is 1.9 GB, so an x86 host toolset reports its symbols as undefined. CMake's default is Native64Bit today; saying it makes the default not matter.",
      "toolset": {
        "value": "ClangCL",
        "strategy": "set"
      },
      "cacheVariables": {
        "NODE_TEST_JOBS": "2",
        "CMAKE_VS_PLATFORM_TOOLSET_HOST_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "windows-msvc",
      "hidden": true,
      "inherits": "release",
      "description": "A consumer built with cl.exe, linking the clang-cl library. Not a CI cell; it is how the claim that a consumer may pick its own compiler is checked.",
      "cacheVariables": {
        "NODE_TEST_JOBS": "2"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "release",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "x64-windows-static",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "x64-windows-static-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "x64-windows-static-md",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "x64-windows-static-md-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "x64-windows",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "x64-windows-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "arm64-windows-static",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "arm64-windows-static-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "arm64-windows-static-md",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "arm64-windows-static-md-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-md",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "arm64-windows",
      "inherits": "windows-clang",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "arm64-windows-msvc",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL"
      }
    },
    {
      "name": "x64-linux",
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "x64-linux-dynamic",
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
      }
    },
    {
      "name": "arm64-linux",
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "arm64-linux-dynamic",
      "inherits": "linux",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
      }
    },
    {
      "name": "arm64-osx",
      "inherits": "macos",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "arm64-osx-dynamic",
      "inherits": "macos",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic"
      }
    },
    {
      "name": "x64-osx",
      "inherits": "macos",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "x64-osx-dynamic",
      "inherits": "macos",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx-dynamic",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "x64-linux-debug",
      "inherits": "linux",
      "displayName": "x64 Linux, Debug",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm64-osx-debug",
      "inherits": "macos",
      "displayName": "arm64 macOS, Debug",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
