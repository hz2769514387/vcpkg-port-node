  "testPresets": [
    {
      "name": "x64-windows-static-fast",
      "configurePreset": "x64-windows-static",
      "configuration": "Release",
      "displayName": "x64-windows-static: everything that takes seconds",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "node-suite|symbols"
        }
      }
    },
    {
      "name": "x64-windows-static-all",
      "configurePreset": "x64-windows-static",
      "configuration": "Release",
      "displayName": "x64-windows-static: everything, including Node.js's own suite",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-linux-fast",
      "configurePreset": "x64-linux",
