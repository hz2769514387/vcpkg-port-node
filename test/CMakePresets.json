{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "公共配置：vcpkg toolchain，triplet 由各平台 preset 给出。",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "NODE_PORT_TEST_SHARDS": "4",
        "NODE_PORT_TEST_JOBS": "1"
      }
    },
    {
      "name": "windows-clang-cl",
      "inherits": "base",
      "displayName": "Windows x64（clang-cl + 静态 CRT + 静态库）",
      "description": "node 24+ 的 Windows 官方口径。toolchain 由本工程（消费端）拥有。",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
        "VCPKG_CRT_LINKAGE": "static",
        "VCPKG_LIBRARY_LINKAGE": "static"
      }
    },
    {
      "name": "windows-clang-cl-arm64",
      "inherits": "base",
      "displayName": "Windows arm64（clang-cl + 静态 CRT + 静态库）",
      "description": "Tier 2：未实测。见 README 的支持矩阵。",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-windows-static-clang",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/clang-cl.cmake",
        "VCPKG_CRT_LINKAGE": "static",
        "VCPKG_LIBRARY_LINKAGE": "static"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "displayName": "Linux x64（gcc + 静态库）",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-arm64",
      "inherits": "base",
      "displayName": "Linux arm64（gcc + 静态库）",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-linux"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macOS arm64（clang + 静态库）",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    },
    {
      "name": "macos-x64",
      "inherits": "base",
      "displayName": "macOS x64（clang + 静态库）",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-cl",
      "configurePreset": "windows-clang-cl"
    },
    {
      "name": "windows-clang-cl-arm64",
      "configurePreset": "windows-clang-cl-arm64"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-arm64",
      "configurePreset": "linux-arm64"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    },
    {
      "name": "macos-x64",
      "configurePreset": "macos-x64"
    }
  ]
}
