{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared settings. VCPKG_ROOT must point at a bootstrapped vcpkg checkout; every preset uses a stock vcpkg triplet, which is the whole point of the port - a consumer is supposed to need nothing else. An unset VCPKG_BUILD_TYPE builds both Release and Debug, so anything that links Debug gets Debug.",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "NODE_TEST_JOBS": "$env{VCPKG_MAX_CONCURRENCY}"
      }
    },
    {
      "name": "windows",
      "inherits": "base",
      "displayName": "Windows x64 (x64-windows-static)",
      "description": "Visual Studio 2022 rather than Ninja so that a Windows consumer needs nothing beyond vcpkg. CMAKE_MSVC_RUNTIME_LIBRARY has to be stated explicitly: vcpkg's own windows.cmake toolchain sets /MT for building ports, but a consumer's CMake never loads it, so it would default to /MD and fail at link time with LNK2038 against the /MT static library.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "NODE_TEST_JOBS": "2"
      }
    },
    {
      "name": "linux",
      "inherits": "base",
      "displayName": "Linux x64 (x64-linux)",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos",
      "inherits": "base",
      "displayName": "macOS arm64 (arm64-osx)",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "macos",
      "configurePreset": "macos"
    }
  ]
}
