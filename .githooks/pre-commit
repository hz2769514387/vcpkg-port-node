#!/bin/sh
# Blocks a commit whose staged lines look like credentials. The scanner and its
# reasoning live in tools/check_secrets.py; this hook only invokes it.
#
# The hook is opt-in by clone - git runs neither this nor anything else unless
# the clone says so:
#
#   git config core.hooksPath .githooks
#
# lint.yml runs the same scanner over the whole history, so a clone that never
# enables the hook is still caught, just later and more publicly.
# python3 first: Debian/Ubuntu and current macOS images have no `python`, and a hook that dies with
# "python: not found" blocks the commit with a message about the wrong thing. The scanner itself is
# Python 3 either way.
if command -v python3 >/dev/null 2>&1; then
  exec python3 tools/check_secrets.py --staged
fi
exec python tools/check_secrets.py --staged
