diff --git a/CMakeLists.txt b/CMakeLists.txt
index 87d6613..0d179a9 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -90,22 +90,38 @@ if (ENABLE_SIMD_OPTIMIZATIONS)
   # Apparently some environments (e.g. CentOS) require to explicitly link
   # with pthread and that is required by the CPU features detection code.
   find_package (Threads REQUIRED)
-  SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -pthread")
-  SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -pthread")
+  # Added by this port's patch set: -pthread is not a flag MSVC or clang-cl accept, and the
+  # Windows CPU detection does not use pthread in the first place.
+  if (NOT WIN32)
+    SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -pthread")
+    SET(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} -pthread")
+  endif()
 
-  if (CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
+  # Rewritten by this port's patch set. Two separate defects, one reason each:
+  #
+  #   * CMake reports AMD64, not x86_64, on Windows, so this block never matched there. The
+  #     result was a Windows build with no SIMD at all - and it did not even get that far,
+  #     because contrib/optimizations/chunkcopy.h errors out when no chunk SIMD define is
+  #     present.
+  #
+  #   * The define set below is Node.js's, not Chromium's. Node.js builds the CPU-dispatch
+  #     optimizations for adler32, the inflate chunk copy and deflate's slide hash, but not the
+  #     crc32 SIMD: it is switched off in node/deps/zlib/zlib.gyp because of the memory
+  #     corruption in https://github.com/nodejs/node/issues/45268. A port that exists to be the
+  #     zlib Node.js ships must not turn on what Node.js refuses to build.
+  if (CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64" OR CMAKE_SYSTEM_PROCESSOR STREQUAL "AMD64")
     add_definitions(-DDEFLATE_COMPARE256_64LE)
     add_definitions(-DINFLATE_CHUNK_SIMD_SSE2)
     add_definitions(-DADLER32_SIMD_SSSE3)
     add_definitions(-DINFLATE_CHUNK_READ_64LE)
     add_definitions(-DDEFLATE_CHUNK_WRITE_64LE)
-    add_definitions(-DCRC32_SIMD_SSE42_PCLMUL)
-    if (ENABLE_SIMD_AVX512)
-      add_definitions(-DCRC32_SIMD_AVX512_PCLMUL)
-    endif()
     add_definitions(-DDEFLATE_SLIDE_HASH_SSE2)
-    # Required by CPU features detection code.
-    add_definitions(-DX86_NOT_WINDOWS)
+    # Required by CPU features detection code, which has one implementation per platform.
+    if (WIN32)
+      add_definitions(-DX86_WINDOWS)
+    else()
+      add_definitions(-DX86_NOT_WINDOWS)
+    endif()
   endif()
 
   if ((CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64") OR
