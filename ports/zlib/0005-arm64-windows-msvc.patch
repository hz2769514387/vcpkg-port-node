diff --git a/CMakeLists.txt b/CMakeLists.txt
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -124,25 +124,47 @@ if (ENABLE_SIMD_OPTIMIZATIONS)
     endif()
   endif()
 
+  # CMake spells one architecture three ways depending on the platform: arm64 and
+  # aarch64 on POSIX, ARM64 on Windows. Without the third, a Windows ARM64 build
+  # matched neither this branch nor the x86_64 one above, so no SIMD define reached
+  # the compiler and the fork died in contrib/optimizations/chunkcopy.h with
+  # "inflate chunk SIMD is not defined for your build target".
   if ((CMAKE_SYSTEM_PROCESSOR STREQUAL "arm64") OR
-      (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64"))
+      (CMAKE_SYSTEM_PROCESSOR STREQUAL "aarch64") OR
+      (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM64"))
     add_definitions(-DINFLATE_CHUNK_SIMD_NEON)
     add_definitions(-DADLER32_SIMD_NEON)
     add_definitions(-DINFLATE_CHUNK_READ_64LE)
     add_definitions(-DDEFLATE_CHUNK_WRITE_64LE)
-    add_definitions(-DCRC32_ARMV8_CRC32)
     add_definitions(-DDEFLATE_SLIDE_HASH_NEON)
     add_definitions(-DDEFLATE_COMPARE256_64LE)
-    # Required by CPU features detection code.
-    if (APPLE)
-      add_definitions(-DARMV8_OS_MACOS)
-    endif()
 
-    if (UNIX AND NOT APPLE)
+    # Required by CPU features detection code: one implementation per platform.
+    if (WIN32)
+      add_definitions(-DARMV8_OS_WINDOWS)
+    elseif (APPLE)
+      add_definitions(-DARMV8_OS_MACOS)
+    elseif (UNIX)
       add_definitions(-DARMV8_OS_LINUX)
     endif()
 
-    SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=armv8-a+crc+crypto")
+    # The two compilers that can build this tree for ARM64 Windows differ, and MSVC
+    # needs three adjustments. CMAKE_C_COMPILER_ID is used rather than MSVC because
+    # clang-cl sets MSVC as well, and everything in this branch is about the front
+    # end, not the compatibility layer:
+    #   * the ARM CRC32 path needs <arm_acle.h>, which the MSVC toolset does not
+    #     ship, so it stays off there. That also keeps the crc32 policy uniform:
+    #     the x86 CRC32 path is off everywhere, because Node.js refuses to build it
+    #     (nodejs/node#45268).
+    #   * the fork gates its NEON code paths on the ACLE macro (cpu_features.c), and
+    #     MSVC does not define it. ARM64 has NEON unconditionally, so it is stated.
+    #   * -march is a clang/gcc flag; MSVC has no equivalent and needs none.
+    if (CMAKE_C_COMPILER_ID STREQUAL "MSVC")
+      add_definitions(-D__ARM_NEON)
+    else()
+      add_definitions(-DCRC32_ARMV8_CRC32)
+      SET(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -march=armv8-a+crc+crypto")
+    endif()
   endif()
 
   if (CMAKE_SYSTEM_PROCESSOR STREQUAL "riscv64")
