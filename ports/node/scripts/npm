#!/bin/sh
# Provided by the node vcpkg port: run the npm installed alongside this node.
# The layout mirrors the official distribution (executable + node_modules/{npm,
# corepack} + shims), so everything is located relative to this script and no
# node/npm from PATH is needed.
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
case $(uname) in
  *CYGWIN* | *MINGW* | *MSYS*) basedir=$(cygpath -w "$basedir") ;;
esac
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/node_modules/npm/bin/npm-cli.js" "$@"
elif [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe" "$basedir/node_modules/npm/bin/npm-cli.js" "$@"
else
  exec node "$basedir/node_modules/npm/bin/npm-cli.js" "$@"
fi