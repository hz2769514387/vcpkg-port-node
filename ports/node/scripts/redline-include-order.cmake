# 红线裁判：config.gypi 的 target_defaults.include_dirs 前两条必须是
# v8 自带的 abseil-cpp 与 highway/src。
#
# 背景（为什么要这条红线）
# ------------------------
# vcpkg 把所有包的头文件都装进同一个 <prefix>/include，manifest 模式下这个目录
# 还是整个工程共用的 vcpkg_installed/<triplet>/include。port 经
# --shared-<lib>-includes 把它交给 configure.py 后，它进了
# target_defaults.include_dirs —— **所有** gyp 目标都看得见，包括 v8 的。
#
# v8 自带 abseil / highway，且用的是它们的**内部符号**，换不掉（实测：换成 vcpkg
# 那份能编过，但链接必挂 LNK2019）。两份同名不同版本：
#   * v8 自带  absl/base/internal/spinlock.h : explicit SpinLock(...)
#   * vcpkg    absl/base/internal/spinlock.h : constexpr explicit SpinLock(...)
# 于是 v8 自己的 absl/base/internal/spinlock.cc 一旦编到 vcpkg 那份头上就
# "redefinition of SpinLock::SpinLock(SchedulingMode)"。
# run #17 的 x64-linux 与 arm64-linux 就是死在第 48/1908 步这里。
#
# 顺序由 ports/node/patches/0015 在 configure.py 末尾**整体前插**得到 —— 不能靠
# --shared-*-includes 的顺序，因为 configure_openssl() 在 configure.py 里是最后
# 调用的（2641 行），append 永远抢不到前排，而 gyp 对 include_dirs 去重只留首次出现。
#
# 为什么做成独立文件
# ------------------
# 症状出现得太晚（编译到中途才炸），写进文档等于没有。做成可 include 的模块后，
# 正反两个方向都能离线真跑：
#   * 喂"顺序退化"的 config.gypi → 必须 FATAL_ERROR
#   * 喂"顺序正确"的 config.gypi → 必须放行
#
# 用法
# ----
#   set(NODE_CONFIG_GYPI "<path to config.gypi>")   # 可选，默认 ${SOURCE_PATH}/config.gypi
#   include(<this file>)
# 违规直接 message(FATAL_ERROR)，不返回。

if(NOT DEFINED NODE_CONFIG_GYPI)
    set(NODE_CONFIG_GYPI "${SOURCE_PATH}/config.gypi")
endif()

if(NOT EXISTS "${NODE_CONFIG_GYPI}")
    message(FATAL_ERROR
        "config.gypi not found: ${NODE_CONFIG_GYPI}\n"
        "configure.py must run before this red-line check.")
endif()

file(READ "${NODE_CONFIG_GYPI}" _node_gypi_text)
# config.gypi 首行是 "# Do not edit. Generated by the configure script."，
# 不是合法 JSON，必须先剥掉这行再 string(JSON)。
string(REGEX REPLACE "^#[^\n]*\n" "" _node_gypi_json "${_node_gypi_text}")

set(_node_expect0 "deps/v8/third_party/abseil-cpp")
set(_node_expect1 "deps/v8/third_party/highway/src")

# string(JSON ...) 成功时 ERROR_VARIABLE 是 NOTFOUND（if() 判假），出错时才是错误信息。
unset(_node_got0)
unset(_node_json_err0)
string(JSON _node_got0 ERROR_VARIABLE _node_json_err0
       GET "${_node_gypi_json}" target_defaults include_dirs 0)
if(_node_json_err0)
    message(FATAL_ERROR
        "cannot read target_defaults.include_dirs[0] from ${NODE_CONFIG_GYPI}: ${_node_json_err0}")
endif()

unset(_node_got1)
unset(_node_json_err1)
string(JSON _node_got1 ERROR_VARIABLE _node_json_err1
       GET "${_node_gypi_json}" target_defaults include_dirs 1)
if(_node_json_err1)
    message(FATAL_ERROR
        "cannot read target_defaults.include_dirs[1] from ${NODE_CONFIG_GYPI}: ${_node_json_err1}")
endif()

if(NOT _node_got0 STREQUAL _node_expect0 OR NOT _node_got1 STREQUAL _node_expect1)
    message(FATAL_ERROR
        "v8 vendored third-party include dirs are NOT first in\n"
        "target_defaults.include_dirs -- ports/node/patches/0015 did not take effect.\n"
        "  expected [0] = ${_node_expect0}\n  actual   [0] = ${_node_got0}\n"
        "  expected [1] = ${_node_expect1}\n  actual   [1] = ${_node_got1}\n"
        "Effect: v8's own absl/*.cc compiles against vcpkg's absl/*.h (same names,\n"
        "different versions) and dies with 'redefinition of\n"
        "SpinLock::SpinLock(SchedulingMode)' -- run #17 killed both linux jobs this way.")
endif()

message(STATUS "node port red line OK: v8 vendored include dirs are first "
               "(abseil-cpp, highway/src)")
