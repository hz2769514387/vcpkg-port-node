#!/bin/sh
# Provided by the node vcpkg port: run the corepack installed alongside this node.
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")
case $(uname) in
  *CYGWIN* | *MINGW* | *MSYS*) basedir=$(cygpath -w "$basedir") ;;
esac
if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/node_modules/corepack/dist/corepack.js" "$@"
elif [ -x "$basedir/node.exe" ]; then
  exec "$basedir/node.exe" "$basedir/node_modules/corepack/dist/corepack.js" "$@"
else
  exec node "$basedir/node_modules/corepack/dist/corepack.js" "$@"
fi