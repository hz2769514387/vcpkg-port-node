# crates.gyp used $(Platform) - a macro only the Visual Studio build defines - in two places the ninja
# generator reads: the libpath it puts on every link line, and the architecture argument handed to
# cargo. gyp passes macros it does not know through verbatim, so the generated ninja file contained
# `$(Platform)/release/...`: in make syntax that is a command substitution, and as a path it is
# invalid. <(target_arch) is the same value as a gyp expansion - vcpkg builds one architecture per
# invocation.
#
--- a/deps/crates/crates.gyp
+++ b/deps/crates/crates.gyp
@@ -20,7 +20,7 @@
         }],
         ['OS=="win"', {
           'variables': {
-            'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/$(Platform)/release/node_crates.lib',
+            'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/<(target_arch)/release/node_crates.lib',
           },
         }, {
           'variables': {
@@ -35,7 +35,7 @@
       'conditions': [
         ['OS=="win"', {
           'variables': {
-            'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/$(Platform)/debug/node_crates.lib',
+            'node_crates_libpath': '<(SHARED_INTERMEDIATE_DIR)/<(target_arch)/debug/node_crates.lib',
           },
         }, {
           'variables': {
@@ -83,7 +83,7 @@
               'action': [
                 '<(python)',
                 'cargo_build.py',
-                '$(Platform)',
+                '<(target_arch)',
                 '<(SHARED_INTERMEDIATE_DIR)',
                 '<@(cargo_build_flags)',
                 '--frozen',
