+      # dynamic triplet, and its own CMake target hands consumers
+      # SIMDJSON_USING_WINDOWS_DYNAMIC_LIBRARY=1 - a define gyp never sees, because the port
+      # links the library by name rather than through that target. Without it the link of
+      # node_mksnapshot fails with LNK2019 on exactly those two symbols and nothing else.
+      #
+      # The variable is passed by the port (`configure.py -DVCPKG_SIMDJSON_USING_DLL=1`) and
+      # only for a dynamic Windows triplet, because with a static simdjson the macro would
+      # make the compiler expect dllimport from an archive that has none.
+      ['OS == "win" and VCPKG_SIMDJSON_USING_DLL=="1"', {
+        'defines': [ 'SIMDJSON_USING_WINDOWS_DYNAMIC_LIBRARY=1' ],
+      }],
