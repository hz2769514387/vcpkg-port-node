+# A dependency that is a DLL on Windows needs a define on the *consuming* side, and gyp is a
+# consumer that never sees the dependency's CMake INTERFACE.  vcpkg's simdjson target carries
+# SIMDJSON_USING_WINDOWS_DYNAMIC_LIBRARY=1 for exactly that reason; two of the globals node
+# references from simdjson.h are data (internal::error_codes,
+# internal::structural_or_whitespace_negated), and data has to be dllimport to be reachable
+# through an import library - without it the link of node_mksnapshot fails with LNK2019 on
+# those two symbols and nothing else.
+#
+# The vcpkg port sets NODE_PORT_SIMDJSON_USING_DLL only for a dynamic Windows triplet: with a
+# static simdjson the macro would make the compiler demand dllimport from an archive that has
+# none.  An environment variable rather than an extra -D: -D reaches gyp (it is forwarded
+# verbatim, which is how VCPKG_SIMDUTF_INCLUDE works), but a gyp condition reading it did not
+# produce the define, and this file's own output['defines'] is the channel the port already
+# uses for build-wide defines.
+if os.environ.get('NODE_PORT_SIMDJSON_USING_DLL'):
+  output['defines'] += ['SIMDJSON_USING_WINDOWS_DYNAMIC_LIBRARY=1']
+
