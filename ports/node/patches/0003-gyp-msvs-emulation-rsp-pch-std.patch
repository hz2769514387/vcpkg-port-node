+def _ReplacePchUsageFlags(flags):
+    """Drop /Yu "use precompiled header" flags.
+
+    They are added to every translation unit through cflags_c/cflags_cc, but the
+    translation unit that *creates* the precompiled header must not also try to
+    use it: cl rejects (or silently mis-handles) /Yu together with /Yc.  MSVC's
+    own project system replaces the usage flag on that single file, so mirror
+    that here.
+    """
+    return [f for f in flags if not f.startswith("/Yu")]
+
