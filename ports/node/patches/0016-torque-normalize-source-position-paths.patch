 void CSAGenerator::EmitSourcePosition(SourcePosition pos, bool always_emit) {
-  const std::string& file = SourceFileMap::AbsolutePath(pos.source);
+  std::string file = SourceFileMap::AbsolutePath(pos.source);
   if (always_emit || !previous_position_.CompareStartIgnoreColumn(pos)) {
     // Lines in Torque SourcePositions are zero-based, while the
     // CodeStubAssembler and downwind systems are one-based.
+    //
+    // The path goes into a C string literal, and an absolute path on Windows uses
+    // native separators: "\d" and "\." are not escape sequences, so the
+    // compiler emits one warning per occurrence - tens of thousands of them in a
+    // debug build of V8 - and the string that ends up in the binary is silently
+    // mangled, since "\v" even becomes a vertical tab. MSBuild hands Torque
+    // forward slashes and the ninja generator hands it native ones, which is why this
+    // only shows up on the ninja path. Normalizing here keeps the generated code valid
+    // on both.
+    std::replace(file.begin(), file.end(), '\\', '/');
     out() << "    ca_.SetSourcePosition(\"" << file << "\", "
           << (pos.start.line + 1) << ");\n";
     previous_position_ = pos;
