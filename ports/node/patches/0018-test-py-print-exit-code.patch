@@ -1588,6 +1598,14 @@
     return "CRASHED (Signal: %d)" % -code
 
 
+def FormatExitCode(code):
+  # P18: see GetFailureOutput. `code` can be None when the process never
+  # started at all, hence the isinstance() guard.
+  if isinstance(code, int):
+    return "%d (0x%08X)" % (code, code & 0xFFFFFFFF)
+  return "%s" % code
