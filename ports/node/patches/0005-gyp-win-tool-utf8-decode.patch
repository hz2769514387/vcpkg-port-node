# Every subprocess in gyp's win_tool.py decodes its output as strict UTF-8, and so do the manifest
# comparisons. On a Windows whose system locale is not UTF-8 - a Chinese Windows prints the compiler's
# and mt.exe's messages in GBK - a single byte outside UTF-8 raised UnicodeDecodeError inside gyp, and
# the real message (a link error, a manifest mismatch) was replaced by a decoding traceback. Reading
# with errors="replace" keeps the message; the bytes that cannot be decoded are not the part being read.
#
--- a/tools/gyp/pylib/gyp/win_tool.py
+++ b/tools/gyp/pylib/gyp/win_tool.py
@@ -137,7 +137,7 @@
             stdout=subprocess.PIPE,
             stderr=subprocess.STDOUT,
         )
-        out = link.communicate()[0].decode("utf-8")
+        out = link.communicate()[0].decode("utf-8", errors="replace")
         for line in out.splitlines():
             if (
                 not line.startswith("   Creating library ")
@@ -217,7 +217,7 @@
             our_manifest = "%(out)s.manifest" % variables
             # Load and normalize the manifests. mt.exe sometimes removes whitespace,
             # and sometimes doesn't unfortunately.
-            with open(our_manifest) as our_f, open(assert_manifest) as assert_f:
+            with open(our_manifest, encoding='utf-8') as our_f, open(assert_manifest, encoding='utf-8') as assert_f:
                 translator = str.maketrans("", "", string.whitespace)
                 our_data = our_f.read().translate(translator)
                 assert_data = assert_f.read().translate(translator)
@@ -227,7 +227,7 @@
                 def dump(filename):
                     print(filename, file=sys.stderr)
                     print("-----", file=sys.stderr)
-                    with open(filename) as f:
+                    with open(filename, encoding='utf-8', errors='replace') as f:
                         print(f.read(), file=sys.stderr)
                         print("-----", file=sys.stderr)
 
@@ -250,7 +250,7 @@
         popen = subprocess.Popen(
             args, shell=True, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT
         )
-        out = popen.communicate()[0].decode("utf-8")
+        out = popen.communicate()[0].decode("utf-8", errors="replace")
         for line in out.splitlines():
             if line and "manifest authoring warning 81010002" not in line:
                 print(line)
