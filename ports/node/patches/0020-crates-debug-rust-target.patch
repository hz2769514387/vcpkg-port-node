+            # configure.py sets cargo_rust_target (for Rosetta), and Debug is a
+            # configuration upstream does not build in CI, which is why this went
+            # unnoticed. Windows is left alone: its Debug action goes through
+            # cargo_build.py, which already takes the architecture as an argument.
+            'cargo_build_flags': ['--target', '<(cargo_rust_target)'],
+          }
+        }],
