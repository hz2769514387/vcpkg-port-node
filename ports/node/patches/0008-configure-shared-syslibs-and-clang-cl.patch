+  # CC may be a bare path containing spaces (common on Windows, e.g.
+  # "C:/Program Files/.../clang-cl.exe").  shlex.split would break it
+  # at the space.  Try the path as-is first; fall back to shlex.split
+  # when CC carries extra flags.
+  cc_clean = CC.strip()
+  if len(cc_clean) >= 2 and cc_clean[0] in ('"', "'") and cc_clean[-1] == cc_clean[0]:
+    cc_clean = cc_clean[1:-1]
+  if os.path.isfile(cc_clean):
+    compiler = [cc_clean]
+  else:
+    compiler = shlex.split(CC)
+  if compiler and compiler[0].replace('\\', '/').endswith('clang-cl.exe'):
+    # clang-cl (the MSVC-compatible clang driver, used by the vcpkg clang-cl
+    # triplet) silently ignores -dM, so the macro dump comes back empty and the
+    # OpenSSL version cannot be determined.  Its sibling clang.exe accepts the
+    # GNU-style flags when told to target the MSVC ABI, so point at that instead.
+    compiler = [
+      c.replace('clang-cl.exe', 'clang.exe') if c.endswith('clang-cl.exe') else c
+      for c in compiler
+    ]
+    args = ['--target=x86_64-pc-windows-msvc'] + args
