+
+# When the caller selects clang-cl (via CC/CXX), tell gyp to drive the build with
+# it.  gyp's ninja generator recognises this exact spelling ("clang-cl" as the CC
+# entry of make_global_settings) and swaps the MSVC cl.exe rule for clang-cl,
+# which is what the vcpkg clang-cl triplet chainloads.  Without this the build
+# falls back to cl.exe and (among other things) rejects the DevTools protocol
+# templates that upstream only ever compiles with clang.
+if sys.platform == 'win32' and 'clang-cl' in (CC + CXX):
+  # gyp treats each make_global_settings value as a bare path: it joins it with
+  # the build directory and re-quotes it later (QuoteShellArgument).  Embedding
+  # quotes here would survive into the ".exe"-suffixed value and defeat gyp's
+  # `endswith("clang-cl")` detection, so hand it the raw path.
+  def _unquote_path(p):
+    p = p.strip()
+    if len(p) >= 2 and p[0] == p[-1] and p[0] in ('"', "'"):
+      p = p[1:-1]
+    return p
+  output['make_global_settings'] = [
+    ['CC', _unquote_path(CC)],
+    ['CXX', _unquote_path(CXX)],
+  ]
