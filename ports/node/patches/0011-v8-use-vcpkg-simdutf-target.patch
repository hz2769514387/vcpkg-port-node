       'all_dependent_settings': {
         'include_dirs': [
-          '<(SIMDUTF_ROOT)',
+          '<(VCPKG_SIMDUTF_INCLUDE)',
+        ],
+        'conditions': [
+          ['OS=="win"', {
+            'libraries': ['-lsimdutf'],
+          }],
+          ['OS!="win"', {
+            'libraries': ['-lsimdutf'],
+          }],
         ],
       },
-      'include_dirs': ['.'],
-      'sources': [
-        '<(SIMDUTF_ROOT)/simdutf.cpp',
