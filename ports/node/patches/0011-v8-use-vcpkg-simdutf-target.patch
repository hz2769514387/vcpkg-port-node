+      # this target only satisfies the dependency edge that deps/ada/ada.gyp
+      # declares unconditionally, and hands out the external include directory.
+      # V8's own sources already include "simdutf.h" without a third_party
+      # prefix, so the external header resolves directly.
+      # The libraries entry in all_dependent_settings propagates the vcpkg
+      # simdutf.lib to every target that depends on this one (including V8
+      # tools like mksnapshot.exe), so the externalized symbols resolve.
       'target_name': 'simdutf',
