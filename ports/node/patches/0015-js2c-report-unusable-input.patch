--- a/tools/js2c.cc
+++ b/tools/js2c.cc
@@ -680,9 +680,68 @@ Fragment GetDefinition(const std::string& var, const std::vector<char>& code) {
 
   // Simplification did not turn the code into 1-byte string. Just
   // use the original.
+  //
+  // Diagnostic added by this repository's patch set: GetDefinitionImpl derives the
+  // output size from simdutf and asserts when the result is zero, which conflates
+  // "this input is not valid UTF-8" with "the simdutf linked into this tool is not
+  // the one it was compiled against". Report both, and report the input's size and
+  // shape, so a failure in a log can be read without a debugger.
+  {
+    size_t diagnostic_length =
+        simdutf::utf16_length_from_utf8(code.data(), code.size());
+    fprintf(stdout,
+            "js2c: two-byte input '%s' size=%zu utf16_length=%zu first=%02X%02X%02X%02X\n",
+            var.c_str(), code.size(), diagnostic_length,
+            code.size() > 0 ? static_cast<unsigned char>(code[0]) : 0,
+            code.size() > 1 ? static_cast<unsigned char>(code[1]) : 0,
+            code.size() > 2 ? static_cast<unsigned char>(code[2]) : 0,
+            code.size() > 3 ? static_cast<unsigned char>(code[3]) : 0);
+    if (diagnostic_length == 0) {
+      fprintf(stdout,
+              "js2c: '%s' is valid UTF-8, yet simdutf reports a UTF-16 length of zero - "
+              "the simdutf linked into this tool does not agree with the headers it was "
+              "compiled against\n",
+              var.c_str());
+    }
+    fflush(stdout);
+  }
   return GetDefinitionImpl<uint16_t>(code, var, CodeType::kTwoByte);
 }
 
+// Added by this repository's patch set.
+//
+// Upstream's answer to an input it cannot embed is `assert(utf16_count != 0)`
+// inside GetDefinitionImpl - correct, but it names neither the file nor the
+// reason, and only three files in the whole tree reach that path
+// (lib/internal/cli_table.js, lib/internal/timers.js and
+// deps/acorn/acorn/dist/acorn.js). When one of them arrives invalid, that is an
+// hour of guessing. Name the file and the offset instead, and fail the build as
+// a normal error.
+//
+// Everything here writes to stdout as well as stderr: vcpkg keeps the two streams
+// in separate files, and only one of them is embedded in the failure report.
+bool InputIsEmbeddable(const std::string& filename, const std::vector<char>& code) {
+  if (code.empty()) {
+    fprintf(stdout, "js2c: %s is empty, and an empty file cannot be embedded\n",
+            filename.c_str());
+    fflush(stdout);
+    return false;
+  }
+  simdutf::result check =
+      simdutf::validate_utf8_with_errors(code.data(), code.size());
+  if (check.error) {
+    size_t offset = check.count;
+    unsigned char byte =
+        offset < code.size() ? static_cast<unsigned char>(code[offset]) : 0;
+    fprintf(stdout,
+            "js2c: %s is not valid UTF-8 (byte 0x%02X at offset %zu of %zu)\n",
+            filename.c_str(), byte, offset, code.size());
+    fflush(stdout);
+    return false;
+  }
+  return true;
+}
