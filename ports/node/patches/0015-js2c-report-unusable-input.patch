   std::vector<char> transformed = JSONify(code);
@@ -882,6 +947,12 @@ int PrintUsage(const char* argv0) {
 }
 
 int Main(int argc, char* argv[]) {
+  // Added by this repository's patch set. A build log has to say whether these
+  // diagnostics are even present, or a silent log is ambiguous between "nothing was
+  // wrong" and "the code was not compiled in".
+  fprintf(stdout, "js2c: diagnostic build of tools/js2c.cc (node port patch set), %d args\n",
+          argc);
+  fflush(stdout);
   if (argc < 3) {
     return PrintUsage(argv[0]);
   }
