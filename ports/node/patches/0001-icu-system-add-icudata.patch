@@ -16,5 +16,14 @@
       'type': 'none',
       'toolsets': [ 'host', 'target' ],
     },
+    {
+      # vcpkg patch：v8.gyp 在 OS=="win" 分支里无条件依赖 <(icu_gyp_path):icudata
+      # （v8.gyp:1315），而上游的 system-icu 清单漏了这个目标 —— Windows + system-icu
