+namespace {
+
+// P16: Normalize path separators to '/' so that paths arriving with
+// Windows separators (e.g. "test\torque\test-torque.tq" from the gyp
+// command line) compare equal to the forward-slash forms used by
+// ClassType::AttributedToFile() ("test/", "src/objects/...").
+std::string NormalizeSeparators(std::string path) {
+  std::replace(path.begin(), path.end(), '\\', '/');
+  return path;
+}
+
+}  // namespace
+
 // static
 SourceId SourceFileMap::AddSource(std::string path) {
-  Get().sources_.push_back(std::move(path));
+  Get().sources_.push_back(NormalizeSeparators(std::move(path)));
   return SourceId(static_cast<int>(Get().sources_.size()) - 1);
 }
 
 // static
 SourceId SourceFileMap::GetSourceId(const std::string& path) {
+  const std::string normalized = NormalizeSeparators(path);
   for (size_t i = 0; i < Get().sources_.size(); ++i) {
-    if (Get().sources_[i] == path) {
+    if (Get().sources_[i] == normalized) {
       return SourceId(static_cast<int>(i));
     }
   }
